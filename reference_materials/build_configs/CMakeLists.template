# CMakeLists.txt Template for Embedded C Projects
# Copy this to your project directory and customize as needed

cmake_minimum_required(VERSION 3.16)
project(embedded_c_project C)

# Set C standard
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)

# Compiler flags
add_compile_options(
    -Wall
    -Wextra
    -Werror
    -pedantic
    -g
    -O0
)

# Main executable
add_executable(program
    main.c
    # Add your source files here:
    # utils.c
    # drivers.c
    # helpers.c
)

# Optional: add include directories
# target_include_directories(program PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include)

# Optional: Testing support
enable_testing()

# Example test executable (uncomment when you have tests)
# add_executable(test_suite
#     test/test_main.c
#     test/test_utils.c
#     utils.c
# )
# add_test(NAME unit_tests COMMAND test_suite)

# Build configuration info
message(STATUS "Build type: ${CMAKE_BUILD_TYPE}")
message(STATUS "C Standard: ${CMAKE_C_STANDARD}")
